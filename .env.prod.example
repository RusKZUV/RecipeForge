# ==============================================================================
# RecipeForge Production Environment Configuration Template (.env.prod.example)
# ==============================================================================

ENVIRONMENT=production
APP_ENV=production
DEBUG=false
PORT=8000
APP_PORT=8000

POSTGRES_USER=recipeforge_prod_user
POSTGRES_PASSWORD=your_production_password_here
POSTGRES_DB=recipeforge_prod_db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://recipeforge_prod_user:your_production_password_here@db-prod:5432/recipeforge_prod_db

JWT_SECRET=your_production_secure_jwt_secret_here
TOKEN_EXPIRE_SECONDS=86400

CORS_ORIGINS=https://recipeforge.yourdomain.com,http://localhost:8000

VITE_USE_MOCK_API=false
VITE_API_URL=

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=recipeforge-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
