# ==============================================================================
# RecipeForge Production Environment Configuration (.env.prod)
# ==============================================================================

# Application Environment & Debugging
ENVIRONMENT=production
APP_ENV=production
DEBUG=false
PORT=8000
APP_PORT=8000

# Database Configuration (Production PostgreSQL Container)
# Dedicated production credentials, database, and isolated volume
POSTGRES_USER=recipeforge_prod_user
POSTGRES_PASSWORD=recipeforge_prod_secure_password_replace_in_ci
POSTGRES_DB=recipeforge_prod_db
POSTGRES_PORT=5432

# Database Connection URL (Targeting prod container db-prod)
DATABASE_URL=postgresql://recipeforge_prod_user:recipeforge_prod_secure_password_replace_in_ci@db-prod:5432/recipeforge_prod_db

# Security & Session Tokens (Must be overridden in CI / production deployment)
JWT_SECRET=prod_super_secure_jwt_secret_token_replace_in_production_2026
TOKEN_EXPIRE_SECONDS=86400

# CORS Allowed Origins (Production domains and local production host)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Frontend Configuration (Production builds serve static frontend on same origin)
VITE_USE_MOCK_API=false
VITE_API_URL=

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=recipeforge-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
