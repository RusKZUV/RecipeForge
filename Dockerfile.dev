# ==============================================================================
# RecipeForge Development Dockerfile (Dockerfile.dev)
# Fast, hot-reloading development container for backend API
# ==============================================================================

FROM python:3.12-slim

WORKDIR /app

# Ensure standard output and error are unbuffered
ENV PYTHONUNBUFFERED=1 \
    PORT=8091 \
    ENVIRONMENT=development \
    DEBUG=true

# Install runtime system dependencies for curl healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy backend dependencies
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source and project metadata
COPY backend/pyproject.toml ./
COPY backend/app/ ./app/

# Expose backend development port
EXPOSE 8091

# Healthcheck endpoint
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8091/health || exit 1

# Launch Uvicorn with auto-reload enabled
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8091", "--reload"]
