# ==============================================================================
# RecipeForge Development Environment Configuration (.env.dev)
# ==============================================================================

# Application Environment & Debugging
ENVIRONMENT=development
APP_ENV=development
DEBUG=true
PORT=8091
APP_PORT=8091

# Database Configuration (Development PostgreSQL Container)
# Dedicated development credentials & database isolated from production
POSTGRES_USER=recipeforge_dev_user
POSTGRES_PASSWORD=recipeforge_dev_password
POSTGRES_DB=recipeforge_dev_db
POSTGRES_PORT=5433

# Database Connection URL (SQLite default for standalone host execution & CI)
DATABASE_URL=sqlite:///./recipeforge_dev.db

# Alternative: Connect to dev PostgreSQL container from host (via port 5433):
# DATABASE_URL=postgresql://recipeforge_dev_user:recipeforge_dev_password@localhost:5433/recipeforge_dev_db

# Security & Session Tokens
JWT_SECRET=dev-insecure-secret-key-recipeforge-local-only
TOKEN_EXPIRE_SECONDS=86400

# CORS Allowed Origins (Local Vite dev server, local origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8091

# Frontend Configuration (for development client builds or Vite)
VITE_USE_MOCK_API=false
VITE_API_URL=http://localhost:8091
